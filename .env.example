# Copie para .env e preencha (não compartilhe este arquivo)
# --- Evolution API (WhatsApp real) ---
EVOLUTION_URL=http://localhost:8080
EVOLUTION_APIKEY=troque-por-senha-forte
EVOLUTION_INSTANCE=atendente

# --- IA (preencha UMA; se deixar vazio funciona em modo regras, grátis) ---
# Pegue grátis em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Ou OpenAI em: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google Calendar (opcional) ---
GOOGLE_CALENDAR_ID=primary
